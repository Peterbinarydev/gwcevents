.golden-btn {
    background: #c2933a !important ;
    background: linear-gradient(270deg,#c2933a 0,#fde974 50%,#f1d768 0,#d2aa4a 0,#c2933a 0,#fddc63 0,#d7a129) !important;
}

.get-invited .elementor-item {
  display: inline-block;
  padding: 10px 20px;
  background-color: #fff; /* Button background color */
  color: #000 !important;
  text-align: center;
  text-decoration: none;
  transition: background-color 0.3s ease, box-shadow 0.3s ease; /* Smooth transition */
}

.get-invited .elementor-item:hover {
  background-color: grey; 
	 color: #fff !important;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); 
}

header{
	padding: 1vw;
	background: #d9d9d9;
}

header h1{
	text-align: center;
	font-size: 2vw !important;
	text-transform: uppercase !important; 
	margin: 0;
}

.single-3d-flip-book .vamtam-main{
	margin: 4% !important;
}

@media (max-width: 667px){
	
header{
	padding: 15px;}
	
header h1{
	font-size: 18px !important;
}

