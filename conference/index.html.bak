<!-- =========================
     COUNTDOWN SCRIPT
========================= -->

<script src="data:text/javascript;base64," data-rocket-status="executed">
(function () {

    var START = new Date("2026-12-11T00:00:00-05:00").getTime();
    var END   = new Date("2026-12-15T23:59:59-05:00").getTime();

    var countdownElement = document.getElementById(
        "i20summit-v2-countdown"
    );

    if (!countdownElement) {
        return;
    }


    function i20SummitV2Pad(number) {
        return number < 10 ? "0" + number : "" + number;
    }


    function i20SummitV2Cell(value, label) {

        return (
            '<div class="i20summit-v2-countdown-item">' +
                '<b class="i20summit-v2-countdown-value">' +
                    value +
                '</b>' +
                '<span class="i20summit-v2-countdown-label">' +
                    label +
                '</span>' +
            '</div>'
        );

    }


    function i20SummitV2Tick() {

        var now = Date.now();


        /* Event finished */

        if (now >= END) {

            countdownElement.innerHTML =
                '<b class="i20summit-v2-countdown-done">' +
                    'See you next year' +
                '</b>';

            return;
        }


        /* Event currently running */

        if (now >= START) {

            countdownElement.innerHTML =
                '<b class="i20summit-v2-countdown-done">' +
                    'The week is live in Miami' +
                '</b>';

            return;
        }


        /* Countdown */

        var difference = START - now;

        var days = Math.floor(
            difference / 864e5
        );

        var hours = Math.floor(
            (difference % 864e5) / 36e5
        );

        var minutes = Math.floor(
            (difference % 36e5) / 6e4
        );

        var seconds = Math.floor(
            (difference % 6e4) / 1e3
        );


        countdownElement.innerHTML =

            i20SummitV2Cell(
                days,
                "Days"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(hours),
                "Hrs"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(minutes),
                "Min"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(seconds),
                "Sec"
            );

    }


    i20SummitV2Tick();

    setInterval(
        i20SummitV2Tick,
        1000
    );

})();
</script>		</div>
