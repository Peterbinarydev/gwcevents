/* CSS code as discussed earlier */

.team-bg {
  position: relative;
  display: flex;
  padding: 0; /* Remove padding or adjust as needed */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400px;
  width: 100%;
  flex-shrink: 0;
  border-radius: 200px;
  background: #F7F7F7;
  overflow: hidden;
  transition: background-color 0.3s ease;
}

.team-bg:hover {
  background: #f00;
  color:#fff
  opacity: 1; /* Adjust opacity on hover */
}

.team-img {
  width: 181px;
  height: 200px;
  border-radius: 50%;
  position: relative;
  top: 1px;
}


.team-icon {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 50px;
  height: 50px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.team-bg:hover .team-icon {
  opacity: 1;
}

.team-bg:hover .content {
  color: #fff; /* Change the text color to white on hover */
