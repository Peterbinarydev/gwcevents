<div
    class="i20summit-v2-wrap i20summit-v2-bottom"
    role="contentinfo">

    <div class="i20summit-v2-red-rule"></div>

    <div class="i20summit-v2-container">

        <div class="i20summit-v2-bottom-row">

            <div>

                <div class="i20summit-v2-bottom-title">
                    The Room Is Forming
                </div>

                <div class="i20summit-v2-bottom-subtitle">
                    500 seats at $5,499 · presented in Miami
                </div>

            </div>


            <a
                class="i20summit-v2-cta"
                href="https://i20summit.com/passes">
                Secure Your Seat
            </a>

        </div>


        <div class="i20summit-v2-meta">

            <span class="i20summit-v2-presented">

                Presented by

                <img data-od-unknown-tag data-od-xpath="/*[1][self::HTML]/*[2][self::BODY]/*[4][self::DIV]/*[2][self::DIV]/*[1][self::FOOTER]/*[1][self::DIV]/*[3][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[2][self::DIV]/*[2][self::DIV]/*[1][self::SPAN]/*[1][self::IMG]"
                    class="i20summit-v2-swfi-logo"
                    src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                    alt="Sovereign Wealth Fund Institute"
                data-lazy-src="https://www.swfi.com/assets/logo-f5d0b5c0.svg" ><noscript><img data-od-unknown-tag data-od-xpath="/*[1][self::HTML]/*[2][self::BODY]/*[4][self::DIV]/*[2][self::DIV]/*[1][self::FOOTER]/*[1][self::DIV]/*[3][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[2][self::DIV]/*[2][self::DIV]/*[1][self::SPAN]/*[1][self::IMG]"
                    class="i20summit-v2-swfi-logo"
                    src="https://www.swfi.com/assets/logo-f5d0b5c0.svg"
                    alt="Sovereign Wealth Fund Institute"
                ></noscript>

