				<div class="elementor-element elementor-element-dbb54e4 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-widget elementor-widget-html" data-id="dbb54e4" data-element_type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
			<script type="rocketlazyloadscript">
document.addEventListener("DOMContentLoaded", () => {
    // Select all tab buttons and tab sections
    const tabButtons = document.querySelectorAll(".tab-buttons a");
    const tabSections = document.querySelectorAll(".tab-sections > div");

    // Set the default active tab
    function setActiveTab(index) {
        // Remove 'active' class from all tab buttons and sections
        tabButtons.forEach(button => button.classList.remove("active"));
        tabSections.forEach(section => section.classList.remove("active"));

        // Add 'active' class to the selected tab button and section
        tabButtons[index].classList.add("active");
        tabSections[index].classList.add("active");
    }

    // Ensure the first tab is active by default
    setActiveTab(0);

    // Add event listeners to each tab button
    tabButtons.forEach((button, index) => {
        button.addEventListener("click", (event) => {
            event.preventDefault(); // Prevent the default link behavior (page reload)
            setActiveTab(index); // Activate the selected tab
        });
    });
});
</script>
		</div>
				</div>
				<div class="elementor-element elementor-element-2386a06 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-widget elementor-widget-html" data-id="2386a06" data-element_type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
			<script type="rocketlazyloadscript">
document.addEventListener("DOMContentLoaded", function() {
    const sliders = document.querySelectorAll('.tab-buttons');

    sliders.forEach(slider => {
        let isDown = false;
        let startX;
        let scrollLeft;

        // Mouse Drag Only
        slider.addEventListener('mousedown', e => {
            isDown = true;
            slider.classList.add('active');
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => {
            isDown = false;
            slider.classList.remove('active');
        });
        slider.addEventListener('mouseup', () => {
            isDown = false;
            slider.classList.remove('active');
        });
        slider.addEventListener('mousemove', e => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 1;
            slider.scrollLeft = scrollLeft - walk;
        });
    });
});
</script>
		</div>
