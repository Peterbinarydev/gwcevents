                    500 seats at $5,499 · presented in Miami
                </div>

            </div>


            <a class="i20summit-v2-cta" href="https://i20summit.com/passes">
                Secure Your Seat
            </a>

        </div>


        <div class="i20summit-v2-meta">

            <span class="i20summit-v2-presented">

                Presented by

                <img data-od-unknown-tag="" data-od-xpath="/*[1][self::HTML]/*[2][self::BODY]/*[4][self::DIV]/*[2][self::DIV]/*[1][self::FOOTER]/*[1][self::DIV]/*[3][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[2][self::DIV]/*[2][self::DIV]/*[1][self::SPAN]/*[1][self::IMG]" class="i20summit-v2-swfi-logo" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" alt="Sovereign Wealth Fund Institute" data-lazy-src="https://www.swfi.com/assets/logo-f5d0b5c0.svg"><noscript><img data-od-unknown-tag data-od-xpath="/*[1][self::HTML]/*[2][self::BODY]/*[4][self::DIV]/*[2][self::DIV]/*[1][self::FOOTER]/*[1][self::DIV]/*[3][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[1][self::DIV]/*[2][self::DIV]/*[2][self::DIV]/*[1][self::SPAN]/*[1][self::IMG]"
                    class="i20summit-v2-swfi-logo"
                    src="https://www.swfi.com/assets/logo-f5d0b5c0.svg"
                    alt="Sovereign Wealth Fund Institute"
                ></noscript>

            </span>

            <span>© 2026 I20 Summit</span>

        </div>


        <div class="i20summit-v2-legal">
            The I20 Summit is an independent initiative of the Sovereign Wealth
            Fund Institute and is not affiliated with, endorsed by, sponsored by,
            or otherwise connected to the G20, the Group of Twenty, or the
            Government of the United States.
        </div>

    </div>

</div>


<!-- =========================
     COUNTDOWN SCRIPT
========================= -->

<script type="rocketlazyloadscript">
(function () {

    var START = new Date("2026-12-11T00:00:00-05:00").getTime();
    var END   = new Date("2026-12-15T23:59:59-05:00").getTime();

    var countdownElement = document.getElementById(
        "i20summit-v2-countdown"
    );

    if (!countdownElement) {
        return;
    }


    function i20SummitV2Pad(number) {
        return number < 10 ? "0" + number : "" + number;
    }


    function i20SummitV2Cell(value, label) {

        return (
            '<div class="i20summit-v2-countdown-item">' +
                '<b class="i20summit-v2-countdown-value">' +
                    value +
                '</b>' +
                '<span class="i20summit-v2-countdown-label">' +
                    label +
                '</span>' +
            '</div>'
        );

    }


    function i20SummitV2Tick() {

        var now = Date.now();


        /* Event finished */

        if (now >= END) {

            countdownElement.innerHTML =
                '<b class="i20summit-v2-countdown-done">' +
                    'See you next year' +
                '</b>';

            return;
        }


        /* Event currently running */

        if (now >= START) {

            countdownElement.innerHTML =
                '<b class="i20summit-v2-countdown-done">' +
                    'The week is live in Miami' +
                '</b>';

            return;
        }


        /* Countdown */

        var difference = START - now;

        var days = Math.floor(
            difference / 864e5
        );

        var hours = Math.floor(
            (difference % 864e5) / 36e5
        );

        var minutes = Math.floor(
            (difference % 36e5) / 6e4
        );

        var seconds = Math.floor(
            (difference % 6e4) / 1e3
        );


        countdownElement.innerHTML =

            i20SummitV2Cell(
                days,
                "Days"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(hours),
                "Hrs"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(minutes),
                "Min"
            ) +

            i20SummitV2Cell(
                i20SummitV2Pad(seconds),
                "Sec"
            );

    }


    i20SummitV2Tick();

    setInterval(
        i20SummitV2Tick,
        1000
    );

})();
</script>		</div>
				</div>
